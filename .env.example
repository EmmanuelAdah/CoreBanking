# ============================================
# Core Banking System - Environment Variables
# Copy to .env and fill in real values
# ============================================

# Database
DATABASE_URL=Host=postgres;Port=5432;Database=corebanking;Username=postgres;Password=SuperSecretDbPass123!

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# JWT Authentication (REQUIRED – use a long random secret ≥ 32 chars)
JWT_SECRET=ChangeThisToAVeryLongRandomSecretKeyAtLeast32CharactersLong!
JWT_ISSUER=CoreBanking
JWT_AUDIENCE=CoreBankingClients
JWT_ACCESS_TOKEN_MINUTES=30

# SMTP / Email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMTP_FROM=noreply@corebanking.local

# Application
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
